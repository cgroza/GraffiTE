# HERV-K v2 discovery test — inputs.
#
# Populate the three paths below, then run ./preflight.sh
# All paths must be ABSOLUTE: nextflow.config runs the container with
# --contain, so a relative path resolves to nothing inside it and the run
# fails late, after the allocation is already spent.

# ---- pick ONE entry point ----
#
# RM_DIR (preferred, much faster): a published 2_Repeat_Filtering directory
# from a previous run. RepeatMasker is skipped entirely -- the run resumes at
# TSD search and goes straight on to the HERV-K step. Must look like:
#     <RM_DIR>/<N>/genotypes_repmasked_filtered.vcf
#     <RM_DIR>/<N>/repeatmasker_dir/indels.fa.out
# Note this must be the PUBLISHED 2_Repeat_Filtering output, not a Nextflow
# work/ directory -- work dirs hold repeatmasker_dir but not the VCF.
RM_DIR=""

# PAV_VCF: the merged PAV call set. Only used when RM_DIR is empty; the run
# then re-masks from scratch, which is the slow path.
PAV_VCF=""

# CHM13v2 FASTA. A .fai beside it is helpful but will be built if absent.
REFERENCE=""

# RepeatMasker library FASTA.
# MUST contain LTR5_Hs and HERVK-int — without them the reference masking
# silently calls every locus `null` and the whole test is meaningless.
# preflight.sh checks this.
TE_LIBRARY=""

# ---- optional, sensible defaults ----

# Local .sif to pin the container. Leave empty to let Nextflow pull
# library://cgroza/collection/graffite:latest itself.
GRAFFITE_SIF=""

OUTDIR="hervk_v2_run"
PROFILE="cluster"        # slurm. Use "standard" only for a local smoke test.
CPUS="8"

# GraffiTE revision. Nextflow caches the repo under ~/.nextflow/assets/.
REVISION="v1.1dev-hervk-v2"
PROJECT="cgroza/GraffiTE"
