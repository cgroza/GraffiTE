# Synthetic end-to-end test set. See README_HPC_CLAUDE.md.
#
# Unlike the earlier handouts, this one generates its own inputs: there is no
# reporter's data to point at. You fill in where things live, not what they are.
#
# All paths must be ABSOLUTE. nextflow.config runs the container with
# --contain, so a relative path resolves to nothing inside it and the run fails
# late, after the allocation is already spent.

# Where to build and run. Needs ~2 GB for the inputs and room for work/.
# On Puma use /xdisk, never /home: work/ will outgrow the home quota.
WORKDIR=""

# The GraffiTE checkout Nextflow caches. bootstrap.sh fills this in; set it
# only if you want a checkout other than ~/.nextflow/assets/cgroza/GraffiTE.
GRAFFITE_REPO=""

# ---- container ----

# Leave empty to let Nextflow pull docker://cgroza/graffite:latest. Apptainer
# converts the Docker reference to a SIF itself; no Sylabs remote is needed any
# more. Set this to a local .sif to pin the image, which is worth doing: the
# tag is mutable, so a rebuild upstream changes the tools underneath you.
GRAFFITE_SIF=""

# Directory bound to /tmp inside the container. Puma's /tmp is small, and the
# symptom of it filling is not an error: the run finishes having skipped
# tsd_search and tsd_report, with no 3_TSD_search/pangenome.vcf. Point this at
# scratch. (--container_tmp is new in v1.1; before it, the only route was
# editing the cached nextflow.config, which then breaks -latest.)
CONTAINER_TMP=""

# ---- execution ----

# "standard" means the LOCAL executor, which is what you want inside an sbatch
# allocation. Do NOT use "cluster" here: Puma charges roughly 85 minutes of
# queue latency per task, and the spine run has hundreds. A 12 h job died that
# way once already (job 23613713).
PROFILE="standard"
CPUS="16"
MEM_GB="80"

# Per-process overrides. The config leaves several memory parameters unset,
# which hands them to the scheduler default.
PANGENIE_MEMORY="40G"
PANGENIE_TIME="4h"
REPEATMASKER_MEMORY="16G"

# ---- pipeline ----

REVISION="test/synthetic-end-to-end"
PROJECT="cgroza/GraffiTE"

# Which runs of the matrix to execute by default. See run_matrix.sh -l.
# "spine" first: everything else either reuses its outputs or is cheap.
RUNS="spine pangenie graphaligner precomputed longreads bams vcf svs duallib guards"

# Generator knobs. Leave the seed alone unless you are deliberately making a
# different genome; every frozen expectation is tied to it.
SEED="20260918"
SHORT_DEPTH="30"
LONG_DEPTH="15"
