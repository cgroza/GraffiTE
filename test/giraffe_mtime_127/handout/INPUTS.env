# Issue #127 test: vg giraffe index mtimes after a scratch copy.
# See README_HPC_CLAUDE.md.
#
# All paths must be ABSOLUTE: nextflow.config runs the container with
# --contain, so a relative path resolves to nothing inside it.

# Where this test writes. On Puma use /xdisk, never /home. Part B puts one
# Nextflow work directory per cell here.
WORKDIR=""

# The synthetic test set's working directory (the WORKDIR of
# test/synthetic/handout). This test reads its build, not its runs, except for
# the spine's pangenome.vcf below. If it has no build/ yet, run the synthetic
# handout's ./preflight.sh once: it builds the inputs and nothing else.
SYNTH_DIR=""

# Inputs, derived from SYNTH_DIR. Override only if they live elsewhere.
REFERENCE=""        # default: $SYNTH_DIR/build/ref/synth.fa
GRAFFITE_VCF=""     # default: $SYNTH_DIR/runs/spine/3_TSD_search/pangenome.vcf
READS_CSV=""        # default: $SYNTH_DIR/build/reads_long.csv (L1 hifi, L2 ont)
READS_FASTQ=""      # default: $SYNTH_DIR/build/reads/L1.long.fq.gz (Part A)

# ---- container ----

# Empty: Part A pulls docker://cgroza/graffite:1.1.0.0 into
# $WORKDIR/singularity once, and Part B points NXF_SINGULARITY_CACHEDIR there
# so both parts use the same image. Set it to a local .sif to skip the pull.
GRAFFITE_SIF=""

# Bound to /tmp inside the container for Part B (--container_tmp).
CONTAINER_TMP=""

# ---- what to test ----

# Part A: source directories the index is built in before being copied.
# The FIRST entry must be what Nextflow uses for scratch under -profile
# cluster: process.scratch = '$SLURM_TMPDIR', which falls back to /tmp when
# SLURM_TMPDIR is unset. Leave empty for that default plus one directory on
# the WORKDIR filesystem, which samples a second filesystem type.
SCRATCH_DIRS=""     # default: "${SLURM_TMPDIR:-/tmp} $WORKDIR/partA_src"

# Part A: independent index builds per source directory.
REPS_A="10"

# Part B: repeats of the scratch cell (each a fresh work directory).
REPS_B="3"

# Part B: scratch setting handed to process.scratch. The default is the
# cluster profile's own value, kept literal so it expands on the node.
NF_SCRATCH='$SLURM_TMPDIR'

# ---- execution ----

# Part B runs Nextflow with the LOCAL executor inside one allocation, like the
# synthetic suite. Scratch staging and unstaging are written by the same
# wrapper for every executor, so the copy step under test is the one
# -profile cluster runs.
CPUS="8"
MEM_GB="32"

REVISION="test/giraffe-mtime-127"
PROJECT="cgroza/GraffiTE"
