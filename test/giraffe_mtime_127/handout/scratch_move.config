// Part B overlay: scratch as in scratch.config, and make_graph's outputs
// leave scratch with mv instead of cp. GNU mv keeps modification times, also
// across filesystems. This is the candidate fix, tried as config only.
process.scratch = System.getenv('MTIME_NF_SCRATCH') ?: '$SLURM_TMPDIR'
process {
    withName: 'make_graph' {
        stageOutMode = 'move'
    }
}
