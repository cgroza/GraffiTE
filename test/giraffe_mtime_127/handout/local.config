// Sizing for a Nextflow driver running inside one sbatch allocation.
//
// Without this, the local executor sizes its pool from the NODE (Puma's are 94
// cores and 470 GB), not from the job cgroup, and then oversubscribes the
// allocation until the scheduler kills it. Both numbers come from INPUTS.env
// via submit_driver.sh, which exports them.
executor {
    $local {
        cpus   = (System.getenv('GT_CPUS') ?: '16') as int
        memory = "${System.getenv('GT_MEM_GB') ?: '80'} GB"
    }
}
